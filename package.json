{
  "name": "penelopa-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@cosmograph/cosmograph": "2.5.1",
    "@cosmograph/react": "2.5.1",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@vinext/cloudflare": "latest",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "lucide-react": "^1.39.0",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "latest",
    "recharts": "^3.10.1",
    "unicode-case-folding": "1.1.1",
    "vinext": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "latest",
    "@types/node": "^26.4.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "esbuild": "0.28.1",
    "postcss": "8.5.26",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "^4.127.1"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "npm run build && vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview": "npm run build && npm run start --",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
    "release:desktop": "node scripts/release-desktop.cjs",
    "test:desktop": "node scripts/test-desktop.cjs",
    "test:mcp": "uv run --no-project --with ./mcp/penelopa-recommendations --with pytest --with pytest-asyncio pytest -q -c mcp/penelopa-recommendations/pyproject.toml mcp/penelopa-recommendations/tests",
    "typecheck": "tsc --noEmit --incremental false",
    "verify:desktop-build": "node scripts/verify-desktop-build.cjs",
    "verify:desktop-assets": "node scripts/verify-desktop-assets.cjs",
    "test:web:unit": "node scripts/test-web-unit.cjs",
    "test:web": "playwright test tests/browser/web-contracts.spec.mjs tests/browser/demo-contracts.spec.mjs tests/browser/loading-experience.spec.mjs tests/browser/sessions.spec.mjs tests/browser/knowledge-graph.spec.mjs",
    "test:web:visual": "playwright test tests/browser/visual-parity.spec.mjs tests/browser/sessions-visual.spec.mjs tests/browser/knowledge-graph-visual.spec.mjs",
    "test:web:production": "playwright test --config playwright.production.config.mjs"
  }
}
