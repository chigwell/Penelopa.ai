#!/bin/sh
set -eu
umask 077

NODE_VERSION='24.20.0'
BOOTSTRAP_SHA='4e653123b90f57baed1e9a593902a271cef94ba86db3e5cb69d06de21e42cc6d'
BASE_URL="${AUTO_IMPROVE_RELEASE_BASE_URL:-https://penelopa.ai/desktop}"
ROOT="${AUTO_IMPROVE_HOME:-$HOME/.auto-improve}"
log() { printf 'Penelopa: %s\n' "$*" >&2; }
die() { log "$*"; exit 1; }
for argument in "$@"; do
  case "$argument" in
    --help|-h)
      cat <<'HELP'
Penelopa.ai — install hooks and build the desktop client locally.

--agent codex|claude|both       Default: both
--desktop auto|off|required    Default: auto (Mac/Windows only)
--no-desktop                   Install hooks only
--diagnose                     Print redacted local diagnostics
--repair                       Repair installed hooks without changing accounts
--uninstall                    Remove Penelopa; retain credentials and queued data
--purge-data                   With --uninstall, also remove local data
--force-new-token              Explicitly request a new account token
--no-launch                    Build without opening the client
--print-access-link            Explicitly reveal a private browser sign-in link
--token TOKEN --url URL --token-url URL --dashboard-url URL
--env-file FILE --hook-url URL --project-id VALUE --data-dir DIRECTORY
--upload-mode segments --source-schema-version VERSION
--segment-max-bytes BYTES --drain-max-attempts COUNT --drain-max-seconds SECONDS
--telegram-settings-url URL --telegram-link-url URL --install-deps

Node/npm are downloaded privately when needed. Git and Python are not required.
HELP
      exit 0 ;;
  esac
done
case "$BASE_URL" in https://*) ;; *) die 'The release server must use HTTPS.' ;; esac
case "$ROOT" in /*) ;; *) die 'AUTO_IMPROVE_HOME must be an absolute path.' ;; esac
for argument in "$@"; do
  case "$argument" in
    --diagnose|--repair|--uninstall)
      if [ -f "$ROOT/node-path" ] && [ -f "$ROOT/bin/penelopa.cjs" ]; then
        node_path=$(cat "$ROOT/node-path")
        [ -x "$node_path" ] || die 'The private runtime is missing. Rerun the installer.'
        exec "$node_path" "$ROOT/bin/penelopa.cjs" "$@"
      fi
      [ "$argument" != '--diagnose' ] && [ "$argument" != '--uninstall' ] || { log 'No managed Penelopa installation found.'; exit 0; }
      die 'No managed installation found. Rerun without --repair.' ;;
  esac
done
fetch() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --proto '=https' --tlsv1.2 --retry 2 --connect-timeout 10 --max-time 300 "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then
    wget -q --timeout=30 --tries=3 "$1" -O "$2"
  else die 'A download tool is needed. Use the download instructions on penelopa.ai from a machine with curl or wget.'; fi
}
checksum() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then openssl dgst -sha256 "$1" | awk '{print $NF}'
  else die 'A SHA-256 tool is required to verify the runtime download.'; fi
}
platform=$(uname -s); architecture=$(uname -m)
case "$platform" in
  Darwin)
    platform=darwin
    if [ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null || true)" = 1 ]; then architecture=arm64; fi ;;
  Linux) platform=linux ;;
  *) die 'Use script.ps1 on Windows. This installer supports macOS and Linux.' ;;
esac
case "$architecture" in aarch64|arm64) architecture=arm64 ;; x86_64|amd64) architecture=x64 ;; *) die 'This CPU architecture has no supported private runtime.' ;; esac
key="$platform-$architecture"
case "$key" in
  darwin-arm64) node_sha='40e5607e5ecb3db9192723776da2d75d966260fc74a7a9e731c1bd67dda96bc8' ;;
  darwin-x64) node_sha='9e5b2644cf107befb6aefca676b96d3296bc10138096f022ed378d6233ed81f4' ;;
  linux-arm64) node_sha='3515603e2487879a39bc75716f1a2affd027500c64ba50e845cf72cb33219013' ;;
  linux-x64) node_sha='855d581f8a4eb1a8117e3426de25fe02770592febcfb31369aee1ffbfee9e8ec' ;;
  *) die 'This platform has no verified private runtime.' ;;
esac
mkdir -p "$ROOT/cache" "$ROOT/runtime"
chmod 700 "$ROOT"
available_kb=$(df -Pk "$ROOT" | awk 'NR == 2 {print $4}')
[ "${available_kb:-0}" -ge 300000 ] || die 'At least 300 MB of free space is needed to prepare the private runtime.'
lock_dir="$ROOT/.bootstrap-lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
  previous_pid=$(cat "$lock_dir/pid" 2>/dev/null || true)
  case "$previous_pid" in ''|*[!0-9]*) die 'Another installer is starting. Retry shortly.' ;; esac
  if kill -0 "$previous_pid" 2>/dev/null; then die 'Another Penelopa installer is running.'; fi
  rm -f "$lock_dir/pid"; rmdir "$lock_dir" || die 'Cannot release a stale installation lock.'
  mkdir "$lock_dir" || die 'Another installer is starting.'
fi
printf '%s\n' "$$" > "$lock_dir/pid"
stage=$(mktemp -d "$ROOT/cache/bootstrap.XXXXXX")
trap 'rm -rf "$stage"; rm -f "$lock_dir/pid"; rmdir "$lock_dir" 2>/dev/null || true' EXIT HUP INT TERM
log 'Preparing runtime'
folder="node-v$NODE_VERSION-$key"
node_path="$ROOT/runtime/$folder/bin/node"
if [ ! -x "$node_path" ] || [ "$("$node_path" --version 2>/dev/null || true)" != "v$NODE_VERSION" ]; then
  fetch "https://nodejs.org/dist/v$NODE_VERSION/$folder.tar.gz" "$stage/node.tar.gz" || die 'Node download failed. Rerun to retry.'
  [ "$(checksum "$stage/node.tar.gz")" = "$node_sha" ] || die 'Node checksum mismatch. Nothing was installed.'
  tar -xzf "$stage/node.tar.gz" -C "$stage" || die 'Cannot extract the runtime.'
  [ "$("$stage/$folder/bin/node" --version 2>/dev/null || true)" = "v$NODE_VERSION" ] || die 'The verified runtime cannot run on this operating system.'
  [ ! -d "$ROOT/runtime/$folder" ] || mv "$ROOT/runtime/$folder" "$stage/runtime.previous"
  if ! mv "$stage/$folder" "$ROOT/runtime/$folder"; then
    [ ! -d "$stage/runtime.previous" ] || mv "$stage/runtime.previous" "$ROOT/runtime/$folder"
    die 'Runtime replacement failed; the previous runtime was preserved.'
  fi
fi
[ "$("$node_path" --version)" = "v$NODE_VERSION" ] || die 'The private Node runtime cannot run on this OS. Check the requirements on penelopa.ai.'
fetch "$BASE_URL/bootstrap.cjs" "$stage/bootstrap.cjs" || die 'Installer download failed. Rerun to retry.'
[ "$(checksum "$stage/bootstrap.cjs")" = "$BOOTSTRAP_SHA" ] || die 'Installer checksum mismatch. Reload the installation command from penelopa.ai.'
"$node_path" "$stage/bootstrap.cjs" "$@"
